{
  "name": "radix2solid-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "capture:sp2": "node scripts/capture-sp2.ts",
    "compare-sp2": "node scripts/capture-sp2.ts --compare",
    "generate:sp2-matrix": "node scripts/generate-sp2-matrix.ts"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.15",
    "@wsagency/radix2solid-primitives": "file:./packs/wsagency-radix2solid-primitives-0.1.0-rc.3.tgz",
    "@wsagency/radix2solid-themes": "file:./packs/wsagency-radix2solid-themes-0.1.0-rc.3.tgz",
    "solid-js": "2.0.0-rc.15"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
