{
  "name": "wseffect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "pnpm --filter @wsagency/wseffect-app build:lint && oxlint",
    "test": "pnpm --recursive --if-present test && node --test scripts/*.test.ts && node scripts/check-update-coverage.ts",
    "check:repo": "node scripts/check-repo.ts",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm check:repo"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.5",
    "@foldkit/vite-plugin": "0.27.1",
    "@playwright/test": "1.64.1",
    "@radix-ui/colors": "3.0.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "10.4.27",
    "effect": "4.0.5",
    "happy-dom": "20.14.5",
    "oxlint": "1.85.0",
    "postcss": "8.5.9",
    "postcss-combine-duplicated-selectors": "10.0.3",
    "postcss-custom-media": "12.0.1",
    "postcss-discard-empty": "7.0.1",
    "postcss-import": "16.1.1",
    "postcss-nesting": "14.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.2",
    "workbox-window": "7.4.1"
  }
}
