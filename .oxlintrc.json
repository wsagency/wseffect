{
  "ignorePatterns": ["packages/app/test/oxlint/fixtures/**"],
  "jsPlugins": [
    {
      "name": "wseffect",
      "specifier": "./packages/app/dist/oxlint-plugin/index.js"
    }
  ],
  "rules": {
    "wseffect/no-effect-promise-in-command": "error",
    "wseffect/no-top-level-side-effects-in-pages": ["error", { "allow": ["Schema.*", "defineMessageUnion", "defineTaggedUnion", "definePage", "Submodel.defineView", "Command.define", "Mount.define", "Mount.defineStream", "createLazy", "createKeyedLazy", "pipe", "Array.from", "VirtualList.view", "Dialog.fold", "Tabs.create", "Tabs.fold", "TabSet.fold", "DropdownMenu.create", "DropdownMenu.fold", "Menu.fold"] }],
    "wseffect/no-page-inputs-in-model": "error"
  }
}
