{
  "ignorePatterns": ["packages/app/test/oxlint/fixtures/**"],
  "jsPlugins": [
    {
      "name": "wseffect",
      "specifier": "./packages/app/dist/oxlint-plugin/index.js"
    }
  ],
  "rules": {
    "wseffect/no-effect-promise-in-command": "error",
    "wseffect/no-top-level-side-effects-in-pages": ["error", { "allow": ["Schema.*", "defineMessageUnion", "defineTaggedUnion", "definePage", "Submodel.defineView", "Command.define", "Mount.define", "Mount.defineStream", "createLazy", "createKeyedLazy", "pipe", "Array.from", "VirtualList.view", "Dialog.fold", "AlertDialog.fold", "HoverCard.fold", "Popover.fold", "Tooltip.fold", "ContextMenu.create", "Tabs.create", "Tabs.fold", "TabSet.fold", "DropdownMenu.create", "DropdownMenu.fold", "Menu.fold", "Select.create", "Picker.fold", "SliderRange.fold", "RadioGroup.create", "RadioCards.create", "SegmentedControl.create"] }],
    "wseffect/no-page-inputs-in-model": "error"
  }
}
