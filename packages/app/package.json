{
  "name": "@wsagency/wseffect-app",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.wsagency.io/ws-agency/wseffect.git",
    "directory": "packages/app"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlint-plugin/index.d.ts",
      "default": "./dist/oxlint-plugin/index.js"
    }
  },
  "bin": {
    "wseffect-codegen": "./dist/codegen/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/brand-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "build:lint": "tsc -p tsconfig.lint.json"
  },
  "peerDependencies": {
    "@effect/platform-browser": "^4.0.5",
    "@foldkit/vite-plugin": "0.27.1",
    "effect": "^4.0.5",
    "foldkit": "0.168.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  },
  "devDependencies": {
    "@foldkit/ui": "0.168.0",
    "@foldkit/vite-plugin": "0.27.1",
    "foldkit": "0.168.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  },
  "dependencies": {
    "idiomorph": "0.8.0"
  }
}
