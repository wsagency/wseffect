{
  "name": "@wsagency/wseffect-app",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "A Foldkit application foundation with lazy page loading, offline support, update prompts, and deployment-version checks.",
  "keywords": ["foldkit", "effect", "application", "lazy-pages", "pwa", "vite"],
  "author": "WS Agency",
  "maintainers": [{ "name": "WS Agency", "url": "https://ws.agency" }],
  "engines": { "node": ">=20.19.0" },
  "homepage": "https://wseffect.com",
  "bugs": { "url": "https://github.com/wsagency/wseffect/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsagency/wseffect.git",
    "directory": "packages/app"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlint-plugin/index.d.ts",
      "default": "./dist/oxlint-plugin/index.js"
    }
  },
  "bin": {
    "wseffect-codegen": "./dist/codegen/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/brand-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "build:lint": "tsc -p tsconfig.lint.json"
  },
  "peerDependencies": {
    "@effect/platform-browser": "^4.0.5",
    "@wsagency/wseffect-vite-plugin": "workspace:*",
    "@wsagency/wseffect-foldkit": "workspace:*",
    "effect": "^4.0.5",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "@wsagency/wseffect-themes": "workspace:*"
  },
  "devDependencies": {
    "@wsagency/wseffect-themes": "workspace:*",
    "@wsagency/wseffect-foldkit-ui": "workspace:*",
    "@wsagency/wseffect-vite-plugin": "workspace:*",
    "@starfederation/datastar-sdk": "1.0.0",
    "@wsagency/wseffect-foldkit": "workspace:*",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  },
  "dependencies": {
    "idiomorph": "0.8.0"
  }
}
