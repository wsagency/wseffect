{
  "name": "@wsagency/wseffect-primitives",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://git.wsagency.io/ws-agency/wseffect.git",
    "directory": "packages/primitives"
  },
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "exports": {
    "./checkbox-group": { "types": "./dist/checkbox-group.d.ts", "default": "./dist/checkbox-group.js" },
    "./select-position": { "types": "./dist/select-position.d.ts", "default": "./dist/select-position.js" },
    "./select": { "types": "./dist/select.d.ts", "default": "./dist/select.js" },
    "./context-menu": { "types": "./dist/context-menu.d.ts", "default": "./dist/context-menu.js" },
    "./range-slider": { "types": "./dist/range-slider.d.ts", "default": "./dist/range-slider.js" },
    "./tooltip-group": { "types": "./dist/tooltip-group.d.ts", "default": "./dist/tooltip-group.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/brand-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src test",
    "test": "vitest run --coverage"
  },
  "dependencies": { "@floating-ui/dom": "1.8.0" },
  "devDependencies": { "@wsagency/wseffect-vite-plugin": "workspace:*", "oxlint": "1.85.0" },
  "peerDependencies": {
    "@wsagency/wseffect-foldkit": "workspace:*",
    "@wsagency/wseffect-foldkit-ui": "workspace:*",
    "effect": "^4.0.5",
    "@effect/platform-browser": "^4.0.5"
  }
}
