{
  "name": "@wsagency/wseffect-vite-plugin",
  "version": "0.27.1",
  "description": "Vite plugin for Foldkit with state-preserving live reload",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@wsagency/wseffect-foldkit": "workspace:*",
    "effect": "4.0.5",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "magic-string": "1.4.2",
    "vitefu": "1.1.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@wsagency/wseffect-foldkit": "workspace:*",
    "effect": "4.0.5",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-host": "npm:vite@8.2.1",
    "vitest": "5.0.2"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "foldkit",
    "live-reload",
    "state-preservation"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/vite-plugin-foldkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
